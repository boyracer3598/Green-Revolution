<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MainMenuStyles.uss?fileID=7433441132597879392&amp;guid=f2a936d679f84cf44b3d3dc98680c531&amp;type=3#MainMenuStyles"/>
    <ui:VisualElement name="body" style="flex-grow: 1; align-items: stretch; border-top-width: -68px; border-right-width: -68px; border-bottom-width: -68px; border-left-width: -68px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; color: rgb(26, 115, 159); border-left-color: rgb(24, 78, 118); border-right-color: rgb(24, 78, 118); border-top-color: rgb(24, 78, 118); border-bottom-color: rgb(24, 78, 118); margin-top: 35px;">
        <ui:Label text="Settings" style="-unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/CherryBombOne-Regular.ttf?fileID=12800000&amp;guid=7c681b37a040a5f4baf060aa6e9c08a5&amp;type=3#CherryBombOne-Regular&quot;); color: rgb(181, 228, 140); align-items: auto; top: auto; position: relative; left: auto; font-size: 37px; background-color: rgba(0, 0, 0, 0); -unity-text-align: upper-center; margin-bottom: 20px; margin-top: 10px;"/>
        <ui:SliderInt label="FX Volume" value="42" high-value="100" name="FX" class="slider" style="-unity-background-image-tint-color: rgb(255, 255, 255); background-color: rgba(255, 255, 255, 0); margin-left: 150px; margin-right: 150px;"/>
        <ui:SliderInt label="Music Volume" value="42" high-value="100" name="music" class="slider" style="-unity-background-image-tint-color: rgb(255, 255, 255); background-color: rgba(255, 255, 255, 0); margin-left: 150px; margin-right: 150px;"/>
        <ui:Toggle label="Mute All Sounds" name="Toggle" style="top: auto; align-items: auto; margin-left: 150px; margin-right: 150px; margin-top: 60px; justify-content: flex-start; align-self: auto;"/>
        <ui:Toggle label="Easy Mode" name="Toggle" style="top: auto; align-items: auto; margin-left: 150px; margin-right: 150px; margin-top: 20px; justify-content: flex-start; align-self: auto;"/>
        <ui:Button text="Back" name="backButton" class="button" style="align-items: stretch; -unity-text-align: middle-center; width: 150px; height: 60px; margin-top: 26px; margin-left: 150px; margin-right: 0; padding-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; margin-bottom: 0;"/>
    </ui:VisualElement>
</ui:UXML>
