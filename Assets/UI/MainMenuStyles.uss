:root {
}

.button {
    background-color: rgb(117, 200, 147);
    color: rgb(181, 228, 140);
    -unity-text-outline-width: 0.5px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/CherryBombOne-Regular.ttf?fileID=12800000&guid=7c681b37a040a5f4baf060aa6e9c08a5&type=3#CherryBombOne-Regular");
    -unity-text-outline-color: rgb(0, 0, 0);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    width: 250px;
    height: 80px;
    font-size: 26px;
    -unity-text-align: middle-left;
    margin-top: 60px;
}

.slider {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/CherryBombOne-Regular.ttf?fileID=12800000&guid=7c681b37a040a5f4baf060aa6e9c08a5&type=3#CherryBombOne-Regular");
    color: rgb(181, 228, 140);
    -unity-text-outline-width: 2px;
    font-size: 25px;
    -unity-font-style: normal;
}

#unity-tracker {
    background-color: rgb(181, 228, 140);
    height: 17px;
    align-items: stretch;
    align-self: auto;
    width: auto;
    top: -4px;
}

#unity-dragger {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgb(117, 200, 147);
    background-size: 100px 100%;
    width: 25px;
    height: 25px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    top: 0;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

#unity-drag-container {
    top: 30px;
}

.unity-toggle {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/CherryBombOne-Regular.ttf?fileID=12800000&guid=7c681b37a040a5f4baf060aa6e9c08a5&type=3#CherryBombOne-Regular");
    font-size: 30px;
    color: rgb(181, 228, 140);
    margin-right: -77px;
    align-self: auto;
    align-items: auto;
    align-content: auto;
    -unity-text-align: upper-left;
}

.unity-toggle__input {
    margin-left: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgba(147, 173, 123, 0);
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
    margin-top: 0;
    margin-bottom: 3px;
    align-self: flex-end;
    align-items: auto;
    transform-origin: center;
    -unity-text-align: upper-left;
    padding-right: 0;
    justify-content: flex-end;
    margin-right: 100px;
}

.unity-toggle__checkmark {
    background-color: rgb(181, 228, 140);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
    border-bottom-left-radius: 7px;
    width: 40px;
    height: 40px;
    -unity-text-align: upper-left;
    align-items: auto;
    align-self: flex-end;
}

.label {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/CherryBombOne-Regular.ttf?fileID=12800000&guid=7c681b37a040a5f4baf060aa6e9c08a5&type=3#CherryBombOne-Regular");
    color: rgb(181, 228, 140);
    align-items: auto;
    top: auto;
    position: relative;
    left: auto;
    font-size: 37px;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: upper-center;
    margin-bottom: 20px;
    margin-top: 10px;
}

.resourceBorder {
    height: 80px;
    width: 80px;
    align-self: flex-start;
    position: absolute;
    top: 12px;
    left: 146px;
}

.unity-tab__header {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Boogaloo-Regular.ttf?fileID=12800000&guid=a0fa8ad870a4a2844aede7c0fbd12732&type=3#Boogaloo-Regular");
    color: rgb(158, 101, 25);
    background-color: rgb(181, 228, 140);
    margin-left: 4px;
}

.unity-tab__header:checked {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgb(116, 200, 147);
}

.unity-tab__header:checked .unity-tab__header-underline {
    background-color: rgba(0, 0, 0, 0);
}

.endTab .unity-tab__header {
}

.unity-progress-bar__background {
    background-color: rgba(253, 253, 253, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.unity-progress-bar__progress {
    background-color: rgb(181, 228, 140);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
}





.StatLabel {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Boogaloo-Regular.ttf?fileID=12800000&guid=a0fa8ad870a4a2844aede7c0fbd12732&type=3#Boogaloo-Regular");
    color: rgb(101, 60, 5);
}

.statBar {
    height: 21px;
    width: 180px;
}

.statGroup {
    flex-direction: row-reverse;
    width: 270px;
    align-items: stretch;
    justify-content: space-between;
    margin-top: -10px;
}
