:root {
}

.button {
    background-color: rgb(117, 200, 147);
    color: rgb(181, 228, 140);
    -unity-text-outline-width: 0.5px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/CherryBombOne-Regular.ttf?fileID=12800000&guid=7c681b37a040a5f4baf060aa6e9c08a5&type=3#CherryBombOne-Regular");
    -unity-text-outline-color: rgb(0, 0, 0);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    width: 250px;
    height: 80px;
    font-size: 26px;
    -unity-text-align: middle-left;
    margin-top: 60px;
}

.slider {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/CherryBombOne-Regular.ttf?fileID=12800000&guid=7c681b37a040a5f4baf060aa6e9c08a5&type=3#CherryBombOne-Regular");
    color: rgb(181, 228, 140);
    -unity-text-outline-width: 2px;
    font-size: 25px;
    -unity-font-style: normal;
}

#unity-tracker {
    background-color: rgb(181, 228, 140);
    height: 17px;
    align-items: stretch;
    align-self: auto;
    width: auto;
    top: -4px;
}

#unity-dragger {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgb(117, 200, 147);
    background-size: 100px 100%;
    width: 25px;
    height: 25px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    top: 0;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

#unity-drag-container {
    top: 30px;
}
