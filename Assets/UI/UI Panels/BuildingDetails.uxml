<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MainMenuStyles.uss?fileID=7433441132597879392&amp;guid=f2a936d679f84cf44b3d3dc98680c531&amp;type=3#MainMenuStyles"/>
    <ui:GroupBox name="backgound" style="background-color: rgb(116, 200, 147); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px;">
        <ui:GroupBox name="wrapper" style="margin-left: 20px;">
            <ui:Label text="Name:" name="Name" class="detailText"/>
            <ui:Label text="Descrition:" name="Description" class="detailText" style="width: 350px; white-space: normal; height: auto;"/>
            <ui:GroupBox name="ProduceWrapper" style="flex-direction: row;">
                <ui:Label text="Produce:" name="Produce" class="detailText" style="height: 49px; width: 101px;"/>
                <ui:GroupBox style="position: relative; top: 1px; left: 155px;">
                    <ui:Image name="ProduceIcon" style="width: 50px; height: 50px; flex-direction: column; background-color: rgb(158, 101, 25); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;"/>
                    <ui:Label text="1" name="ProduceAmount" class="detailText" style="-unity-text-align: upper-center;"/>
                </ui:GroupBox>
            </ui:GroupBox>
            <ui:Label text="Upkeep" name="Upkeep" class="detailText"/>
            <ui:GroupBox name="UpKeepGroup" style="flex-direction: row;">
                <ui:GroupBox>
                    <ui:Image source="project://database/Assets/UI/Icons/wood.png?fileID=2800000&amp;guid=e04bc7d79851ce14a93c0fbc33976679&amp;type=3#wood" style="width: 50px; height: 50px; flex-direction: column; background-color: rgb(158, 101, 25); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;"/>
                    <ui:Label text="1" name="UpkeepWood" class="detailText" style="-unity-text-align: upper-center;"/>
                </ui:GroupBox>
                <ui:GroupBox>
                    <ui:Image source="project://database/Assets/UI/Icons/wheat.png?fileID=2800000&amp;guid=e69617eba0fc5ec45bd95bf33f589c4e&amp;type=3#wheat" style="width: 50px; height: 50px; flex-direction: column; background-color: rgb(158, 101, 25); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;"/>
                    <ui:Label text="1" name="UpKeepCrops" class="detailText" style="-unity-text-align: upper-center;"/>
                </ui:GroupBox>
                <ui:GroupBox>
                    <ui:Image source="project://database/Assets/UI/Icons/food.png?fileID=2800000&amp;guid=fc6a262ad452393488052c3226f14095&amp;type=3#food" style="width: 50px; height: 50px; flex-direction: column; background-color: rgb(158, 101, 25); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;"/>
                    <ui:Label text="1" name="UpKeepFood" class="detailText" style="-unity-text-align: upper-center;"/>
                </ui:GroupBox>
                <ui:GroupBox>
                    <ui:Image source="project://database/Assets/UI/Icons/stone.png?fileID=2800000&amp;guid=a59d68a960807da4598bbe5faf9f5c54&amp;type=3#stone" style="width: 50px; height: 50px; flex-direction: column; background-color: rgb(158, 101, 25); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;"/>
                    <ui:Label text="1" name="UpKeepStone" class="detailText" style="-unity-text-align: upper-center;"/>
                </ui:GroupBox>
                <ui:GroupBox>
                    <ui:Image source="project://database/Assets/UI/Icons/fuel.png?fileID=2800000&amp;guid=12569d06a2ed14e419def523157a72f6&amp;type=3#fuel" style="width: 50px; height: 50px; flex-direction: column; background-color: rgb(158, 101, 25); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;"/>
                    <ui:Label text="1" name="UpKeepFuel" class="detailText" style="-unity-text-align: upper-center;"/>
                </ui:GroupBox>
            </ui:GroupBox>
            <ui:Label text="Pollution:" name="Pollution" class="detailText"/>
        </ui:GroupBox>
    </ui:GroupBox>
</ui:UXML>
