    <ui:GroupBox name="OkayPopUp" enabled="true" style="margin-top: 173px;">
        <ui:VisualElement name="Background" style="flex-grow: 1; width: 300px; height: 220px; background-color: rgb(111, 166, 192); border-left-color: rgb(102, 60, 4); border-right-color: rgb(102, 60, 4); border-top-color: rgb(102, 60, 4); border-bottom-color: rgb(102, 60, 4); border-top-width: 6px; border-right-width: 6px; border-bottom-width: 6px; border-left-width: 6px; border-top-left-radius: 9px; border-top-right-radius: 9px; border-bottom-right-radius: 9px; border-bottom-left-radius: 9px; align-self: center;">
            <ui:Label text="The world is close to the end" name="Message" style="-unity-text-align: upper-center; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Boogaloo-Regular.ttf?fileID=12800000&amp;guid=a0fa8ad870a4a2844aede7c0fbd12732&amp;type=3#Boogaloo-Regular&quot;); font-size: 25px; color: rgb(253, 253, 253); -unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 1.5px; margin-top: 12px; align-self: center; width: 250px; white-space: normal;"/>
