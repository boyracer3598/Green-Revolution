<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MainMenuStyles.uss?fileID=7433441132597879392&amp;guid=f2a936d679f84cf44b3d3dc98680c531&amp;type=3#MainMenuStyles"/>
    <ui:GroupBox name="OkayPopUp" enabled="true">
        <ui:VisualElement name="Background" style="flex-grow: 1; width: 300px; height: 220px; background-color: rgb(111, 166, 192); border-left-color: rgb(102, 60, 4); border-right-color: rgb(102, 60, 4); border-top-color: rgb(102, 60, 4); border-bottom-color: rgb(102, 60, 4); border-top-width: 6px; border-right-width: 6px; border-bottom-width: 6px; border-left-width: 6px; border-top-left-radius: 9px; border-top-right-radius: 9px; border-bottom-right-radius: 9px; border-bottom-left-radius: 9px; align-self: center;">
            <ui:Label text="The world is close to the end" name="Message" style="-unity-text-align: upper-center; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Boogaloo-Regular.ttf?fileID=12800000&amp;guid=a0fa8ad870a4a2844aede7c0fbd12732&amp;type=3#Boogaloo-Regular&quot;); font-size: 21px; color: rgb(226, 28, 28); -unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 1px; margin-top: 56px; align-self: center;"/>
            <ui:Button text="Okay" name="OkayButton" class="button" style="margin-top: 23px; margin-left: 0; margin-right: 0; margin-bottom: 0; padding-bottom: 0; padding-top: 0; padding-left: 0; padding-right: 0; -unity-text-align: middle-center; height: 44px; width: 177px; align-self: center;"/>
        </ui:VisualElement>
    </ui:GroupBox>
    <ui:GroupBox name="YesNoPopUp">
        <ui:VisualElement name="Background" style="flex-grow: 1; width: 300px; height: 220px; background-color: rgb(111, 166, 192); border-left-color: rgb(102, 60, 4); border-right-color: rgb(102, 60, 4); border-top-color: rgb(102, 60, 4); border-bottom-color: rgb(102, 60, 4); border-top-width: 6px; border-right-width: 6px; border-bottom-width: 6px; border-left-width: 6px; border-top-left-radius: 9px; border-top-right-radius: 9px; border-bottom-right-radius: 9px; border-bottom-left-radius: 9px; align-self: center;">
            <ui:Label text="This is going to be harmful are you sure want to do this" name="Message" style="-unity-text-align: upper-center; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Boogaloo-Regular.ttf?fileID=12800000&amp;guid=a0fa8ad870a4a2844aede7c0fbd12732&amp;type=3#Boogaloo-Regular&quot;); font-size: 21px; color: rgb(234, 190, 69); -unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 1px; margin-top: 29px; align-self: center; width: 230px; flex-wrap: nowrap; white-space: pre-wrap;"/>
            <ui:GroupBox style="flex-direction: row; align-self: center; margin-top: 16px;">
                <ui:Button text="yes" name="YesButton" class="button" style="margin-top: 0; margin-left: 0; margin-right: 0; margin-bottom: 0; padding-bottom: 0; padding-top: 0; padding-left: 0; padding-right: 0; -unity-text-align: middle-center; height: 37px; width: 78px; align-self: center;"/>
                <ui:GroupBox style="height: 47px; width: 26px;"/>
                <ui:Button text="No" name="NoButton" class="button" style="margin-top: 0; margin-left: 0; margin-right: 0; margin-bottom: 0; padding-bottom: 0; padding-top: 0; padding-left: 0; padding-right: 0; -unity-text-align: middle-center; height: 37px; width: 78px; align-self: center;"/>
            </ui:GroupBox>
        </ui:VisualElement>
    </ui:GroupBox>
</ui:UXML>
