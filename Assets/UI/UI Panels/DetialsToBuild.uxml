<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MainMenuStyles.uss?fileID=7433441132597879392&amp;guid=f2a936d679f84cf44b3d3dc98680c531&amp;type=3#MainMenuStyles"/>
    <ui:GroupBox name="body">
        <ui:GroupBox name="wrapper" style="background-color: rgb(117, 200, 147); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; border-left-width: 18px; border-top-width: 7px; width: 350px;">
            <ui:Label text="Name:" name="Name" class="detailText"/>
            <ui:Label text="Cost" name="Cost" class="detailText" style="-unity-text-align: upper-center;"/>
            <ui:GroupBox style="flex-direction: row;">
                <ui:GroupBox>
                    <ui:Image source="project://database/Assets/UI/Icons/wood.png?fileID=2800000&amp;guid=e04bc7d79851ce14a93c0fbc33976679&amp;type=3#wood" style="width: 50px; height: 50px; background-color: rgb(158, 101, 25); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;"/>
                    <ui:Label text="1&#10;" name="WoodAmount" class="detailText" style="-unity-text-align: upper-center; font-size: 25px;"/>
                </ui:GroupBox>
                <ui:GroupBox>
                    <ui:Image source="project://database/Assets/UI/Icons/wheat.png?fileID=2800000&amp;guid=e69617eba0fc5ec45bd95bf33f589c4e&amp;type=3#wheat" style="width: 50px; height: 50px; background-color: rgb(158, 101, 25); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;"/>
                    <ui:Label text="1&#10;" name="CropAmount" class="detailText" style="-unity-text-align: upper-center; font-size: 25px;"/>
                </ui:GroupBox>
                <ui:GroupBox>
                    <ui:Image source="project://database/Assets/UI/Icons/food.png?fileID=2800000&amp;guid=fc6a262ad452393488052c3226f14095&amp;type=3#food" style="width: 50px; height: 50px; background-color: rgb(158, 101, 25); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;"/>
                    <ui:Label text="1&#10;" name="FoodAmount" class="detailText" style="-unity-text-align: upper-center; font-size: 25px;"/>
                </ui:GroupBox>
                <ui:GroupBox>
                    <ui:Image source="project://database/Assets/UI/Icons/stone.png?fileID=2800000&amp;guid=a59d68a960807da4598bbe5faf9f5c54&amp;type=3#stone" style="width: 50px; height: 50px; background-color: rgb(158, 101, 25); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;"/>
                    <ui:Label text="1&#10;" name="StoneAmount" class="detailText" style="-unity-text-align: upper-center; font-size: 25px;"/>
                </ui:GroupBox>
                <ui:GroupBox>
                    <ui:Image source="project://database/Assets/UI/Icons/fuel.png?fileID=2800000&amp;guid=12569d06a2ed14e419def523157a72f6&amp;type=3#fuel" style="width: 50px; height: 50px; background-color: rgb(158, 101, 25); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;"/>
                    <ui:Label text="1&#10;" name="FuelAmount" class="detailText" style="-unity-text-align: upper-center; font-size: 25px;"/>
                </ui:GroupBox>
            </ui:GroupBox>
        </ui:GroupBox>
    </ui:GroupBox>
</ui:UXML>
