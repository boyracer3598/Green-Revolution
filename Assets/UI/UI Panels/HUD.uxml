            <ui:VisualElement name="satsBackground" style="flex-grow: 1; background-color: rgb(117, 200, 147); width: 300px; margin-left: 60px; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px;">
                <ui:ScrollView horizontal-page-size="100" vertical-page-size="100" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="AlwaysVisible" name="StatView" class="unity-tracker" style="height: 125px; width: 286px; margin-left: 8px; margin-top: 8px;">
                    <ui:GroupBox name="statGroup" class="statGroup">
                        <ui:ProgressBar value="120" title="100" high-value="200" name="LandPollution" class="statBar"/>
                        <ui:Label text="Land Pollution" class="StatLabel"/>
                    </ui:GroupBox>
                    <ui:GroupBox name="statGroup" class="statGroup">
                        <ui:ProgressBar value="120" title="" high-value="200" name="AirPollutionStatus" class="statBar"/>
                        <ui:Label text="Air Pollution" class="StatLabel"/>
                    </ui:GroupBox>
                    <ui:GroupBox name="statGroup" class="statGroup">
                        <ui:ProgressBar value="120" title="" high-value="200" name="WaterPollutionStatus" enabled="true" class="statBar"/>
                        <ui:Label text="Water Pollution" enabled="true" class="StatLabel"/>
                    </ui:GroupBox>
                    <ui:GroupBox name="statGroup" class="statGroup">
                        <ui:ProgressBar value="120" title="" high-value="200" name="HappinessStatus" class="statBar"/>
                        <ui:Label text="Happiness" class="StatLabel"/>
                    </ui:GroupBox>
                    <ui:GroupBox name="statGroup" class="statGroup">
                        <ui:ProgressBar value="120" title="" high-value="200" name="InspirationStatus" class="statBar"/>
                        <ui:Label text="Inspiration" class="StatLabel"/>
                    </ui:GroupBox>
                    <ui:GroupBox name="statGroup" class="statGroup">
                        <ui:ProgressBar value="120" title="" high-value="200" name="PopulationStatus" class="statBar"/>
                        <ui:Label text="Population" class="StatLabel"/>
                    </ui:GroupBox>
                    <ui:GroupBox name="statGroup" class="statGroup">
                        <ui:ProgressBar value="120" title="" high-value="200" name="EmployedPopulationStatus" class="statBar"/>
                        <ui:Label text="Employed Pop" class="StatLabel"/>
                    </ui:GroupBox>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:GroupBox>
    </ui:GroupBox>
</ui:UXML>
